datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  isVerified Boolean @default(false)
  role      Role     @default(USER)
  cartData  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  verificationTokens VerificationToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Collection {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  numId       Int      @unique
  ref         String?
  name        String
  slug        String   @unique
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])
  sub         String?
  description String   @db.Text
  about       String?  @db.Text
  composition String?  @db.Text
  price       Float
  imageUrl    String
  images      Json?    // Array of extra images
  sizes       String   @default("P,M,G,GG")
  sizeMatrix  Json?    // Complex size/stock matrix like [{s: 'M', q: 5}]
  inStock     Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  status      ProductStatus @default(ACTIVE)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  quote       String?  @db.Text
  buttonText  String?
  buttonLink  String?
  imageUrl    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  customerName  String
  customerEmail String?
  customerPhone String?
  totalPrice    Float
  status        String   @default("PENDING")
  items         String   @db.Text
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  id         String   @id @default("global")
  isLocked   Boolean  @default(false)
  accessCode String?
  lockMessage String?
  updatedAt  DateTime @updatedAt
}

model Coupon {
  id                      String             @id @default(cuid())
  code                    String             @unique
  name                    String
  description             String?            @db.Text
  internalId              String?
  discountType            String             @default("PERCENTAGE") // PERCENTAGE, FIXED, FREE_SHIPPING
  discountValue           Float
  maxDiscountAmount       Float?
  minOrderValue           Float?
  subtotalEligible        Boolean            @default(true)
  canStack                Boolean            @default(false)
  startDate               DateTime           @default(now())
  endDate                 DateTime?
  timezone                String             @default("America/Sao_Paulo")
  status                  String             @default("ACTIVE") // DRAFT, SCHEDULED, ACTIVE, PAUSED, EXPIRED, EXHAUSTED, ARCHIVED
  sellerScope             String             @default("ALL") // ALL, SELECTED
  productScope            String             @default("ALL") // ALL, SELECTED_PRODUCTS, SELECTED_CATEGORIES
  totalUsageLimit         Int?
  usagePerCustomerLimit   Int                @default(1)
  usagePerOrderLimit      Int                @default(1)
  financialBudget         Float?
  financingType           String             @default("MARKETPLACE_100") // MARKETPLACE_100, SELLER_100, SHARED
  marketplaceSharePercent Float              @default(100)
  sellerSharePercent      Float              @default(0)
  usedCount               Int                @default(0)
  totalDiscountGiven      Float              @default(0)
  totalMarketplaceCost    Float              @default(0)
  totalSellerCost         Float              @default(0)
  version                 Int                @default(1)
  createdByAdmin          String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  sellers                 CouponSeller[]
  products                CouponProduct[]
  categories              CouponCategory[]
  redemptions             CouponRedemption[]
  auditLogs               CouponAuditLog[]
}

model CouponSeller {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  sellerId   String
  sellerName String?
  createdAt  DateTime @default(now())

  @@index([couponId])
}

model CouponProduct {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId  String
  isExcluded Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([couponId])
}

model CouponCategory {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  isExcluded Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([couponId])
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponCode      String
  orderId         String?
  customerName    String
  customerEmail   String?
  customerPhone   String?
  subtotal        Float
  discountAmount  Float
  finalTotal      Float
  marketplaceCost Float
  sellerCost      Float
  itemsCount      Int      @default(1)
  status          String   @default("CONFIRMED")
  createdAt       DateTime @default(now())

  @@index([couponId])
}

model CouponAuditLog {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  action    String
  details   String   @db.Text
  changedBy String
  createdAt DateTime @default(now())

  @@index([couponId])
}


